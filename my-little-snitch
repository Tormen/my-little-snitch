@dataclass
class Cli:
    command: Optional[str] = None
    args: List[str] = field(default_factory=lambda: [])
    quiet: Optional[bool] = None
    vrb: Optional[bool] = None
    dbg: Optional[bool] = None
    config: Optional[str] = None


def parse_cli(argv: Sequence[str]) -> Cli:
    """The global options anywhere; the rest belongs to the command."""
    c = Cli()
    it = iter(argv)
    for a in it:
        key, eq, val = a.partition("=")
        if a in ("-Q", "--quiet"):
            c.quiet = True
        elif a in ("-V", "--verbose"):
            c.vrb = True
        elif a in ("-D", "--debug"):
            c.dbg = True
        elif key == "--config":
            v = val if eq else next(it, None)
            if not v:
                err("00047", "--config needs a <FILE>")
            c.config = v
        elif a in ("-h", "--help"):
            c.command = "help"
        elif c.command is None:
            if a.startswith("-"):
                verb = a.lstrip("-")
                hint = f" -- you mean `{SCRIPT_NAME} {verb}`" if verb in COMMANDS else f" ({SCRIPT_NAME} --help)"
                err("00048", f"no such option '{a}'{hint}")
            if a not in COMMANDS:
                err("00049", f"'{a}' is no command ({SCRIPT_NAME} --help)")
            c.command = a
        else:
            c.args.append(a)
    return c


def create_config(target: Optional[str]) -> int:
    if target is None:
        sys.stdout.write(DEFAULT_CONFIG)
        return 0
    p = Path(target)
    try:
        with p.open("x", encoding="utf-8") as f:
            f.write(DEFAULT_CONFIG)
    except FileExistsError:
        err("00050", f"{p} exists -- never written over (compare it with `{SCRIPT_NAME} --create-config`)")
    OUT.msg(f" >>> wrote the default config to {p}")
    return 0


_geteuid: Callable[[], int] = os.geteuid


def run(argv: Sequence[str]) -> int:
    first, _, value = (argv[0] if argv else "").partition("=")
    if first == "--run-tests":
        return run_tests(argv[1] if len(argv) > 1 else "")
    if first == "--version":
        OUT.result(version_line())
        return 0
    if first == "--create-config":
        return create_config(value or (argv[1] if len(argv) > 1 else None))
    c = parse_cli(argv)
    if c.command in (None, "help"):
        OUT.result(HELP)
        return 0
    if _geteuid() != 0:
        err("00051", f"needs root -- littlesnitch refuses anyone else; as root: {SCRIPT_NAME} {shlex.join(argv)}")
    s = load_settings(c.config)
    OUT.dbg_on = c.dbg if c.dbg is not None else s.dbg
    OUT.vrb = OUT.dbg_on or (c.vrb if c.vrb is not None else s.vrb)
    OUT.quiet = (c.quiet if c.quiet is not None else s.quiet) and not OUT.vrb   # -V beats -Q
    install_completion()
    if c.command == "list":
        return cmd_list(s, c.args)
    if c.command in ("allow", "deny"):
        return cmd_add(s, c.command, c.args)
    if c.command == "remove":
        return cmd_remove(s, c.args)
    if c.command == "cleanup":
        return cmd_cleanup(s, c.args)
    if c.command == "log":
        return cmd_log(s, c.args)
    return cmd_diag(s, c.args)


