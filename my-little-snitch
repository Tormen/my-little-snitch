_completion_on = True     # off in --run-tests: a test never writes into $HOME


def install_completion() -> None:
    """The zsh completion, written when it changed -- best effort, never fails a run."""
    if not _completion_on:
        return
    try:
        folder = Path.home() / ".zsh" / "completions"
        target = folder / f"_{SCRIPT_NAME}"
        if target.is_file() and target.read_text(encoding="utf-8") == COMPLETION:
            return
        folder.mkdir(parents=True, exist_ok=True)
        tmp = folder / f".{target.name}.{os.getpid()}"
        tmp.write_text(COMPLETION, encoding="utf-8")
        os.chmod(tmp, 0o644)
        os.replace(tmp, target)
        for dump in Path.home().glob(".zcompdump*"):
            dump.unlink()
        zshrc = Path.home() / ".zshrc"
        if zshrc.is_file() and ".zsh/completions" not in zshrc.read_text(encoding="utf-8"):
            with zshrc.open("a", encoding="utf-8") as f:
                f.write("\nfpath=(~/.zsh/completions $fpath); autoload -Uz compinit && compinit\n")
        OUT.det(f"    > zsh completion written: {target}")
    except OSError as e:
        OUT.dbg(f"zsh completion not written: {e}")


def trace_file() -> Path:
    return Path(tempfile.gettempdir()) / f"{SCRIPT_NAME}.{datetime.datetime.now():%Y-%m-%d_%H%M%S}.{os.getpid()}.trace"


def main(argv: Sequence[str]) -> int:
    """Every way a run ends: 0; 1 with ONE error line; 130 on Ctrl-C; 70 and a
    trace file on a bug -- never a traceback on the screen."""
    try:
        return run(argv)
    except SnitchError as e:
        OUT.error(f"ERROR {e.code} [1]: {e.text}")
        return 1
    except KeyboardInterrupt:
        OUT.error(f"{SCRIPT_NAME}: interrupted (Ctrl-C) while {_phase} -- nothing restored after that point; "
                  f"run it again")
        return 130
    except OSError as e:
        OUT.error(f"ERROR 00052 [1]: while {_phase}: {e.strerror or e}" + (f": {e.filename}" if e.filename else ""))
        return 1
    except Exception as e:   # a bug: one line here, the trace in a file
        where = trace_file()
        try:
            where.write_text(f"{version_line()}\nargv: {list(argv)}\n\n{traceback.format_exc()}", encoding="utf-8")
        except OSError:
            where = Path("(not written)")
        OUT.error(f"ERROR 00053 [70]: unexpected {type(e).__name__} while {_phase} -- the trace: {where}")
        return 70


