def t_ctrl_c(t: T) -> None:
    """A REAL SIGINT while remove waits for IDs on stdin: rc 130, one line."""
    env = dict(os.environ, MY_LITTLE_SNITCH_TEST_ROOT="1")
    p = subprocess.Popen([sys.executable, os.path.realpath(__file__), "--config", str(t.config()), "remove"],
                         stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env)
    time.sleep(2)
    p.send_signal(signal.SIGINT)
    out, errs = p.communicate(timeout=30)
    t.check(p.returncode == 130, f"rc {p.returncode}: {errs}")
    t.check("interrupted (Ctrl-C) while reading the IDs on stdin" in errs and "Traceback" not in errs, errs)
    t.check(len(errs.strip().splitlines()) == 1 and out == "", f"one line: {errs!r}")


