def t_remove_and_cleanup(t: T) -> None:
    t.passed_roundtrip()
    _, out, _ = t.run(["list", "pypi"])
    rc, _, errs = t.run(["remove"], stdin=out)
    t.check(rc == 0 and "would be removed" in errs and len(t.rules()) == 5, f"remove without go: {errs}")
    rc, _, errs = t.run(["remove", "go"], stdin=out)
    t.check(rc == 0 and len(t.rules()) == 4 and not any(r.get("remote-domains") == "pypi.org" for r in t.rules()),
            f"the IDs on stdin, removed: {errs}")
    rc, _, errs = t.run(["remove", "go", "abcdef"])
    t.check(rc == 1 and "no rule with ID abcdef" in errs, errs)
    rc, out, errs = t.run(["cleanup"])
    t.check(rc == 0 and len(out.splitlines()) == 2 and len(t.rules()) == 4, f"cleanup shows the outdated: {out}")
    _, listed, _ = t.run(["list"])
    t.check([x for x in listed.splitlines() if "cleanup?" in x] == out.splitlines(),
            "'cleanup?' in list = what cleanup removes")
    rc, _, errs = t.run(["cleanup", "go"])
    t.check(rc == 0 and len(t.rules()) == 2, f"cleanup go: {errs}")


def t_log(t: T) -> None:
    rc, out, _ = t.run(["log", "aria2c", "--since", "2d"])
    lines = out.splitlines()
    t.check(rc == 0 and len(lines) == 2 and all(" aria2c " in x for x in lines), f"every version of aria2c: {out}")
    t.check("DENIED 1" in lines[1] and "DENIED" not in lines[0], f"denials shown: {out}")
    local = datetime.datetime(2026, 10, 22, 0, 41, 7, tzinfo=datetime.timezone.utc).astimezone()
    t.check(lines[0].startswith(f"{local:%Y-%m-%d %H:%M:%S}"), f"local time: {lines[0]}")
    _, out, _ = t.run(["log", "--denied"])
    t.check(len(out.splitlines()) == 1, f"--denied: {out}")
    _, out, _ = t.run(["log", "updates"])
    t.check(len(out.splitlines()) == 1 and "updates.example.com" in out, f"a FILTER: {out}")
    t.check("in 100 B out 200 B  3 connects" in lines[0] and "in 0 B out 0 B  1 connect  DENIED 1" in lines[1],
            f"bytes always, then the new connects: {out}")
    _, out, _ = t.run(["log", "stream"])
    t.check(out.strip().endswith("in 1.5 MB out 512 B") and "connect" not in out,
            f"bytes with no new connection: no '0 connects', which read as nothing happened: {out}")
    _, out, _ = t.run(["-V", "log", "aria2c"])
    t.check(str(t.cellar) in out, f"-V: the full path: {out}")


def t_refusals(t: T) -> None:
    global _geteuid
    _geteuid = lambda: 501
    try:
        rc, _, errs = t.run(["list"])
    finally:
        _geteuid = lambda: 0
    t.check(rc == 1 and "needs root" in errs, f"not root: {errs}")
    t.mode("unauthorized")
    rc, _, errs = t.run(["list"])
    t.check(rc == 1 and "Allow access via Terminal" in errs and len(errs.strip().splitlines()) == 1, errs)
    for argv, want in ((["--list"], "you mean `my-little-snitch list`"), (["lsit"], "'lsit' is no command"),
                       (["allow", "x"], "allow [go] <PROCESS> <REMOTE>"), (["log", "--since", "1y"], "--since '1y'")):
        rc, _, errs = t.run(argv)
        t.check(rc == 1 and want in errs, f"{argv}: {errs}")


def t_lock(t: T) -> None:
    t.passed_roundtrip()
    lock = t.dir / "state" / "lock"
    lock.mkdir()
    (lock / "owner").write_text(f"pid={os.getpid()} at=now\n")
    rc, _, errs = t.run(["allow", "go", "aria2c", "x.org"])
    t.check(rc == 1 and "another my-little-snitch" in errs and len(t.rules()) == 5, f"a live lock: {errs}")
    p = subprocess.Popen(["true"])
    p.wait()
    (lock / "owner").write_text(f"pid={p.pid} at=then\n")
    rc, _, errs = t.run(["allow", "go", "aria2c", "x.org"])
    t.check(rc == 0 and "breaking a stale lock" in errs and len(t.rules()) == 6 and not lock.exists(), errs)


def t_output_layers(t: T) -> None:
    plain = t.run(["list"])
    quiet = t.run(["-Q", "list"])
    verbose = t.run(["-V", "list"])
    t.check(plain[1] == quiet[1] == verbose[1] != "", "stdout: the same results in every layer")
    t.check(plain[2] != "" and quiet[2] == "", f"-Q: nothing on the terminal: {quiet[2]!r}")
    t.check(all(line in verbose[2] for line in plain[2].splitlines()) and len(verbose[2]) > len(plain[2]),
            "-V adds to the default, never replaces it")


