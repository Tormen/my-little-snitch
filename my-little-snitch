    if os.environ.get("MY_LITTLE_SNITCH_TEST_ROOT") == "1":     # t_ctrl_c's child: a test run, not root
        _geteuid = lambda: 0
    signal.signal(signal.SIGINT, signal.default_int_handler)
    sys.exit(main(sys.argv[1:]))
