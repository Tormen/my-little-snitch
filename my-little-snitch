from typing import Callable, Dict, Final, Generator, List, NoReturn, Optional, Sequence, Tuple, cast

SCRIPT_NAME: Final = "my-little-snitch"
SCRIPT_VERSION: Final = "1.0"
SCRIPT_COMMIT: Final = "unstamped"
REPOSITORY: Final = "Tormen/my-little-snitch"      # whose tags --version may read as releases


# --- 1. output, errors -----------------------------------------------------

class SnitchError(Exception):
    """The tool's one failure: a code naming the source line, and what to know."""

    def __init__(self, code: str, text: str) -> None:
        super().__init__(f"{code}: {text}")
        self.code = code
        self.text = text


def err(code: str, text: str) -> NoReturn:
    raise SnitchError(code, text)


class Out:
    """stdout carries results only; the narration goes to stderr (silenced by -Q)."""

    def __init__(self) -> None:
        self.quiet = False
        self.vrb = False
        self.dbg_on = False

    def msg(self, text: str) -> None:
        if not self.quiet:
            print(text, file=sys.stderr, flush=True)

    def det(self, text: str) -> None:
        if self.vrb:
            self.msg(text)

    def dbg(self, text: str) -> None:
        if self.dbg_on:
            print(" ~~~ " + text, file=sys.stderr, flush=True)

    def warn(self, text: str) -> None:
        print("WARNING: " + text, file=sys.stderr, flush=True)

    def error(self, text: str) -> None:
        print(text, file=sys.stderr, flush=True)

    def result(self, line: str) -> None:
        print(line, flush=True)


OUT = Out()
_phase = "starting"


def phase(text: str) -> None:
    """What the run is doing now -- the Ctrl-C line names it."""
    global _phase
    _phase = text
    OUT.dbg(f"phase: {text}")


# --- 1. config -------------------------------------------------------------

DEFAULT_CONFIG: Final = '''\
## my-little-snitch.conf -- KEY="value" lines. my-little-snitch READS this
## file, it never runs it: no commands; $NAME and ${NAME} expand a key set
## above, or the environment. Searched, first found wins (--help).

## Little Snitch's command line tool
LITTLESNITCH="/Applications/Little Snitch.app/Contents/Components/littlesnitch"

## where each change first saves the whole model (a JSON export), the lock,
## and the record that 'diag roundtrip go' passed. Root only (0700).
BACKUP_DIR="/var/db/my-little-snitch"

## the owner of a new rule when --owner is not given: a user name (Little
## Snitch's "Me" of that user), "anyone" or "system". "": --owner is required.
OWNER_DEFAULT=""

## where 'allow aria2c' looks for a bare program name, after $PATH
PROGRAM_PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin"

## the defaults of -Q / -V / -D ("1" = on)
QUIET=""
VRB=""
DBG=""
'''


@dataclass(frozen=True)
class Settings:
    """The config, parsed: every key typed, every default from DEFAULT_CONFIG."""

    files: Tuple[Path, ...]
    littlesnitch: str
    backup_dir: Path
    owner_default: str
    program_path: Tuple[str, ...]
    quiet: bool
    vrb: bool
    dbg: bool


def config_search_paths() -> List[Path]:
    """Where the config is looked for, in order (after $MY_LITTLE_SNITCH_CONFIG and --config)."""
    site = Path(os.environ.get("LINKS", "/LINKS")) / "default"
    return [site / f"{SCRIPT_NAME}.conf", site / SCRIPT_NAME, Path.home() / f".{SCRIPT_NAME}.conf",
            Path("/etc") / f"{SCRIPT_NAME}.conf", Path("/usr/local/etc") / f"{SCRIPT_NAME}.conf"]


def config_offer() -> List[str]:
    """Where to write a config, most common place first -- a FILTER of the
    search list, so it never names a place that is not read."""
    searched = config_search_paths()
    return [str(p) for p in (Path("/etc") / f"{SCRIPT_NAME}.conf", Path.home() / f".{SCRIPT_NAME}.conf")
            if p in searched]


_KEY_LINE: Final = re.compile(r"([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
_NAME_REF: Final = re.compile(r"\$(?:\{([A-Za-z_][A-Za-z0-9_]*)\}|([A-Za-z_][A-Za-z0-9_]*))")


def _expand(text: str, names: Dict[str, str], where: str) -> str:
    if "$(" in text or "`" in text:
        err("00001", f"{where}: a command substitution -- {SCRIPT_NAME} reads its config, it never runs it")

    def one(m: re.Match[str]) -> str:
        name = m.group(1) or m.group(2)
        if name in names:
            return names[name]
        if name in os.environ:
            return os.environ[name]
        if name == "USER":
            return getpass.getuser()
        if name == "HOME":
            return str(Path.home())
        err("00002", f"{where}: ${name} is not set (a key above, or the environment)")

    return _NAME_REF.sub(one, text)


def parse_value(raw: str, names: Dict[str, str], where: str) -> str:
    """One shell word: unquoted, "double" ($ expanded) and 'single' parts, a
    leading ~ as $HOME, then nothing but a # comment."""
    out: List[str] = []
    i = 0
    while i < len(raw):
        c = raw[i]
        if c == "'":
            j = raw.find("'", i + 1)
            if j < 0:
                err("00003", f"{where}: a ' is not closed")
            out.append(raw[i + 1:j])
            i = j + 1
        elif c == '"':
            j = i + 1
            part: List[str] = []
            while j < len(raw) and raw[j] != '"':
                if raw[j] == "\\" and j + 1 < len(raw) and raw[j + 1] in '"\\$`':
                    j += 1
                part.append(raw[j])
                j += 1
            if j >= len(raw):
                err("00004", f"{where}: a \" is not closed")
            out.append(_expand("".join(part), names, where))
            i = j + 1
        elif c in " \t":
            rest = raw[i:].strip()
            if rest and not rest.startswith("#"):
                err("00005", f"{where}: more than one word -- quote the value")
            break
        else:
            m = re.match(r"[^'\" \t]+", raw[i:])
            assert m is not None, "c is none of the characters the word stops at"
            word = m.group(0)
            i += len(word)
            if not out and (word == "~" or word.startswith("~/")):
                word = str(Path.home()) + word[1:]
            out.append(_expand(word, names, where))
    return "".join(out)


def read_config_text(text: str, where: str, names: Dict[str, str]) -> List[str]:
    """Add the KEY=value lines of `text` to `names`; return the keys it set."""
    keys: List[str] = []
    for n, line in enumerate(text.splitlines(), 1):
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        m = _KEY_LINE.match(s)
        if m is None:
            err("00006", f"{where}:{n}: not a KEY=\"value\" line -- {SCRIPT_NAME} reads its config, it never runs it: {s[:60]}")
        names[m.group(1)] = parse_value(m.group(2), names, f"{where}:{n}")
        keys.append(m.group(1))
    return keys


def _flag(value: str, key: str, where: str) -> bool:
    if value in ("", "0"):
        return False
    if value == "1":
        return True
    err("00007", f"{where}: {key}=\"{value}\" -- \"1\" (on) or \"\" (off)")


def load_settings(override: Optional[str]) -> Settings:
    """The config: the defaults, then <FILE>.GLOBAL, then <FILE> on top."""
    phase("reading the config")
    names: Dict[str, str] = {}
    defaults = read_config_text(DEFAULT_CONFIG, "the built-in defaults", names)
    chosen = override or os.environ.get("MY_LITTLE_SNITCH_CONFIG")
    if chosen:
        if not Path(chosen).is_file():
            err("00008", f"config '{chosen}' not found (--config / $MY_LITTLE_SNITCH_CONFIG)")
        found = Path(chosen)
    else:
        hits = [p for p in config_search_paths() if p.is_file()]
        if not hits:
            lines = "\n".join(f"        > {SCRIPT_NAME} --create-config > {p}" for p in config_offer())
            err("00009", f"no config found -- write one, most common place first:\n{lines}\n"
                         f"    ({SCRIPT_NAME} --help lists every place it is looked for)")
        found = hits[0]
    files = [p for p in (found.with_name(found.name + ".GLOBAL"), found) if p.is_file()]
    for p in files:
        try:
            text = p.read_text(encoding="utf-8")
        except OSError as e:
            err("00010", f"cannot read the config {p}: {e.strerror}")
        for key in read_config_text(text, str(p), names):
            if key not in defaults:
                OUT.warn(f"{p}: {key} is not a {SCRIPT_NAME} setting -- ignored ('{SCRIPT_NAME} --create-config' lists them)")
    where = " + ".join(str(p) for p in files)
    return Settings(
        files=tuple(files), littlesnitch=names["LITTLESNITCH"], backup_dir=Path(names["BACKUP_DIR"]),
        owner_default=names["OWNER_DEFAULT"],
        program_path=tuple(d for d in names["PROGRAM_PATH"].split(":") if d),
        quiet=_flag(names["QUIET"], "QUIET", where), vrb=_flag(names["VRB"], "VRB", where),
        dbg=_flag(names["DBG"], "DBG", where))


# --- 2. littlesnitch ---------------------------------------------------------

Rule = Dict[str, object]
COUNTERS: Final = ("useCount", "lastUsed")


def littlesnitch(s: Settings, *args: str, timeout: float = 300) -> str:
    """One littlesnitch call; its stdout. Its two refusals become one line
    each that says what to do."""
    cmd = [s.littlesnitch, *args]
    OUT.det(f" >>> {shlex.join(cmd)}")
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    except FileNotFoundError:
        err("00011", f"Little Snitch's command line tool is not at {s.littlesnitch} (LITTLESNITCH in the config)")
    except subprocess.TimeoutExpired:
        err("00012", f"littlesnitch {args[0]} gave no answer within {timeout:.0f}s")
    said = (r.stdout + r.stderr).strip()
    if "not authorized" in said:
        err("00013", "Little Snitch refuses its command line tool -- switch on "
                     "Little Snitch > Settings > Security > \"Allow access via Terminal\"")
    if "must be run as root" in said:
        err("00014", f"littlesnitch needs root -- rerun as root: {SCRIPT_NAME} {shlex.join(sys.argv[1:])}")
    if r.returncode != 0:
        err("00015", f"littlesnitch {args[0]} failed [rc {r.returncode}]: {said[:300]}")
    return r.stdout


def export_model(s: Settings, dest: Path) -> Dict[str, object]:
    """The whole model, through a file only root reads."""
    littlesnitch(s, "export-model", str(dest))
    try:
        data = json.loads(dest.read_text(encoding="utf-8"))
    except (OSError, ValueError) as e:
        err("00016", f"the export {dest} is no JSON model: {e}")
    if not isinstance(data, dict) or not isinstance(cast(Dict[str, object], data).get("rules"), list):
        err("00017", f"the export {dest} has no 'rules' list -- has Little Snitch changed its format?")
    return cast(Dict[str, object], data)


def rules_of(model: Dict[str, object]) -> List[Rule]:
    return cast(List[Rule], model["rules"])


def rule_key(r: Rule) -> str:
    """The rule without what Little Snitch counts by itself."""
    return json.dumps({k: v for k, v in r.items() if k not in COUNTERS}, sort_keys=True)


def rule_id(r: Rule) -> str:
    """6 hex: the same from one export to the next, since a rule has no id of its own."""
    return hashlib.sha256(rule_key(r).encode()).hexdigest()[:6]


SAME_FIELDS: Final = ("action", "process", "via", "direction", "remote", "remote-domains", "remote-hosts",
                      "remote-addresses", "ports", "protocol", "uid", "owner", "disabled")


def rule_meaning(r: Rule) -> str:
    """What a rule decides -- two rules with the same meaning are one rule twice."""
    return json.dumps({k: r.get(k) for k in SAME_FIELDS}, sort_keys=True)


def show_process(r: Rule) -> str:
    p = r.get("process")
    if p is None:
        return "any"
    text = str(p)
    for prefix, shown in (("path.", "/"), ("script.", "script /"), ("identifier.", "")):
        if text.startswith(prefix):
            return shown + text[len(prefix):].lstrip("/")     # script. keeps its leading /, path. drops it
    return text


def show_remote(r: Rule) -> str:
    for key in ("remote-domains", "remote-hosts", "remote-addresses"):
        if key in r:
            return str(r[key])
    return str(r.get("remote", "any"))


def show_port(r: Rule) -> str:
    proto, port = r.get("protocol"), r.get("ports")
    if proto is None and port is None:
        return "any"
    return f"{proto or 'any'}/{port or 'any'}"


def show_owner(r: Rule) -> str:
    if r.get("owner") == "system":
        return "system"
    uid = r.get("uid")
    if uid is None:
        return "anyone"
    try:
        return pwd.getpwuid(int(str(uid))).pw_name
    except (KeyError, ValueError):
        return f"uid {uid}"


_VERSION_DIR: Final = re.compile(r"/Cellar/[^/]+/\d[^/]*/")


def program_paths(r: Rule) -> List[str]:
    """The file(s) a rule names on disk -- none for any process or a code identity."""
    p = str(r.get("process", ""))
    for prefix in ("path.", "script."):
        if p.startswith(prefix):
            return ["/" + p[len(prefix):].lstrip("/")]
    return [p] if p.startswith("/") else []


def verdict(r: Rule) -> str:
    """The last column of `list`: <action>?[<reason>], or nothing to do."""
    if not all(star_matches(path) for path in program_paths(r)):
        return "cleanup?[never-matches]"
    for path in program_paths(r):
        if not (glob.glob(path) if "*" in path else os.path.lexists(path)):
            return "cleanup?[program-gone]"
    uid = r.get("uid")
    if uid is not None:
        try:
            pwd.getpwuid(int(str(uid)))
        except (KeyError, ValueError):
            return "cleanup?[user-gone]"
    if r.get("action") == "suggestion":
        return "cleanup?[expired]"
    if any(_VERSION_DIR.search(path) for path in program_paths(r)):
        return "allow?[version-path]"
    return ""


def rule_line(r: Rule) -> str:
    """ID, a TAB (so `cut -f 1` takes it), then the rule; the verdict last."""
    action = str(r.get("action", "?")) + (" (off)" if r.get("disabled") else "")
    direction = "in " if r.get("direction") == "incoming" else ""
    cols = f"{show_process(r)}  {direction}{action}  {show_remote(r)}  {show_port(r)}  {show_owner(r)}"
    v = verdict(r)
    return f"{rule_id(r)}\t{cols}" + (f"   {v}" if v else "")


# --- 3. programs -------------------------------------------------------------

_CELLAR: Final = re.compile(r"^(?P<pre>.*/Cellar/)(?P<formula>[^/@]+)(?P<at>@[^/]+)?/(?P<ver>[^/]+)/(?P<rest>.*)$")
_PY_BIN: Final = re.compile(r"^(?P<fw>.*/Python\.framework/Versions/[^/]+)/bin/python[0-9.]*$")


@dataclass(frozen=True)
class Program:
    """A program as a rule names it: the `process` value, what was asked, and
    what was done to the path on the way."""

    process: Optional[str]          # None: any process
    asked: str
    path: str
    note: str


_VERSION_STAR: Final = re.compile(r"/Cellar/[^/*]+/\*/[^*]*$")


def star_matches(path: str) -> bool:
    """Whether Little Snitch can match this path: it has no wildcards in
    process paths but ONE, its own -- a '*' standing for the folder of
    Homebrew's version, right after Cellar/<formula>/ (as its alert writes
    it). A '*' anywhere else is stored by restore-model and never matches."""
    return "*" not in path or _VERSION_STAR.search(path) is not None


def find_program(s: Settings, asked: str) -> Program:
    """`any`, a path, or a bare name looked up on $PATH and PROGRAM_PATH. A
    Homebrew one gets Little Snitch's own form -- its version folder as '*',
    nothing else changed (a new python@3.16 is another program) -- and a
    Python is its Python.app, which is what connects. A path given with a
    '*' is taken only in that one place."""
    if asked == "any":
        return Program(None, asked, "", "")
    if "*" in asked:
        if not asked.startswith("/"):
            err("00018", f"'{asked}': a pattern must be a full path")
        if not star_matches(asked):
            err("00019", f"'{asked}': Little Snitch matches a '*' only as Homebrew's version folder "
                         f"(/Cellar/<formula>/*/...) -- anywhere else it never matches")
        if not glob.glob(asked):
            err("00019", f"'{asked}' matches no file")
        return Program("path." + asked[1:], asked, asked, "")
    if "/" in asked:
        found = asked
    else:
        dirs = os.environ.get("PATH", "").split(":") + list(s.program_path)
        hit = shutil.which(asked, path=":".join(d for d in dirs if d))
        if hit is None:
            err("00020", f"no program '{asked}' on $PATH or PROGRAM_PATH -- give its full path")
        found = hit
    if not os.path.exists(found):
        err("00021", f"'{found}' does not exist")
    real = os.path.realpath(found)
    notes: List[str] = []
    py = _PY_BIN.match(real)
    if py:
        real = py.group("fw") + "/Resources/Python.app/Contents/MacOS/Python"
        notes.append("a Python connects as its Python.app")
    m = _CELLAR.match(real)
    if m:
        real = f"{m.group('pre')}{m.group('formula')}{m.group('at') or ''}/*/{m.group('rest')}"
        notes.append("its version folder made '*', as Little Snitch's alert writes it, so upgrades keep the rule")
    via = f"from {asked}" + (f" = {found}" if found != asked else "")
    return Program("path." + real.lstrip("/"), asked, "/" + real.lstrip("/"), f"({via}: {'; '.join(notes)})" if notes else "")


def find_owner(s: Settings, given: Optional[str]) -> Tuple[Rule, str]:
    """The owner fields of a new rule, and how to show them."""
    owner = given or s.owner_default
    if not owner:
        err("00022", "whose rule? --owner <USER>|anyone|system (or OWNER_DEFAULT in the config)")
    if owner == "anyone":
        return {}, "anyone"
    if owner == "system":
        return {"owner": "system"}, "system"
    try:
        return {"uid": pwd.getpwnam(owner).pw_uid}, owner
    except KeyError:
        err("00023", f"--owner '{owner}': no such user here (a user, anyone or system)")


# --- 4. changing the model -----------------------------------------------------

def _alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


@contextlib.contextmanager
def locked(s: Settings) -> Generator[None, None, None]:
    """One change at a time: an atomic mkdir, the owner's pid inside. A dead
    owner's lock is broken, and said; a live one is never waited for."""
    lock = s.backup_dir / "lock"
    while True:
        try:
            lock.mkdir()
            break
        except FileExistsError:
            try:
                owner = (lock / "owner").read_text(encoding="utf-8").strip()
            except OSError:
                owner = ""
            m = re.match(r"pid=(\d+)", owner)
            if m is None or _alive(int(m.group(1))):
                err("00024", f"another {SCRIPT_NAME} is changing the rules ({owner or 'owner not yet written'}): "
                             f"{lock} -- run again when it is done")
            OUT.msg(f" >>> breaking a stale lock: its owner is gone ({owner})")
            with contextlib.suppress(OSError):
                (lock / "owner").unlink()
            with contextlib.suppress(OSError):
                lock.rmdir()
    try:
        (lock / "owner").write_text(f"pid={os.getpid()} at={datetime.datetime.now():%Y-%m-%d %H:%M:%S}\n",
                                    encoding="utf-8")
        yield
    finally:
        with contextlib.suppress(OSError):
            (lock / "owner").unlink()
        with contextlib.suppress(OSError):
            lock.rmdir()


def prepare_dir(s: Settings) -> None:
    try:
        s.backup_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        os.chmod(s.backup_dir, 0o700)
    except OSError as e:
        err("00025", f"cannot make BACKUP_DIR {s.backup_dir}: {e.strerror}")


ROUNDTRIP_OK: Final = "roundtrip.ok"


def change_model(s: Settings, change: Callable[[List[Rule]], List[Rule]], expect: Callable[[List[Rule]], List[str]],
                 roundtrip: bool = False) -> Path:
    """Export (the backup), change a copy, export again and refuse if a rule
    moved meanwhile, restore, export and check the change is all that
    changed. NOT atomic: a rule Little Snitch makes during the restore call
    itself is lost -- the backup is the remedy. Returns the backup."""
    prepare_dir(s)
    if not roundtrip and not (s.backup_dir / ROUNDTRIP_OK).is_file():
        err("00026", f"no change before '{SCRIPT_NAME} diag roundtrip go' has passed on this machine: "
                     "it proves a restore loses nothing")
    with locked(s):
        backup = s.backup_dir / f"{datetime.datetime.now():%Y-%m-%d_%H%M%S}.json"
        phase("exporting the rules (the backup)")
        model = export_model(s, backup)
        os.chmod(backup, 0o600)
        OUT.det(f"    > backup: {backup}")
        before = rules_of(model)
        after = change([dict(r) for r in before])
        model["rules"] = after
        new = s.backup_dir / f".{SCRIPT_NAME}.{os.getpid()}.new.json"
        check = s.backup_dir / f".{SCRIPT_NAME}.{os.getpid()}.check.json"
        try:
            new.write_text(json.dumps(model), encoding="utf-8")
            os.chmod(new, 0o600)
            phase("exporting again, to see whether a rule moved meanwhile")
            again = rules_of(export_model(s, check))
            if [rule_key(r) for r in again] != [rule_key(r) for r in before]:
                err("00027", "a rule changed in Little Snitch while this run prepared its change -- "
                             "nothing restored; run it again")
            phase("restoring the changed rules")
            littlesnitch(s, "restore-model", "-t", str(new))
            phase("exporting once more, to check the change")
            now = rules_of(export_model(s, check))
            wrong = expect(now)
            if wrong:
                err("00028", "after the restore the rules are not what was asked: " + "; ".join(wrong[:5])
                             + f" -- the rules before are in {backup}; as root: "
                             + shlex.join([s.littlesnitch, "restore-model", "-t", str(backup)]))
        finally:
            for p in (new, check):
                with contextlib.suppress(OSError):
                    p.unlink()
    return backup


def expect_rules(want: List[Rule]) -> Callable[[List[Rule]], List[str]]:
    """The check after a restore: the same rules as `want`, by meaning; the
    dates and counters are Little Snitch's to keep."""
    def check(now: List[Rule]) -> List[str]:
        have = sorted(rule_meaning(r) for r in now)
        asked = sorted(rule_meaning(r) for r in want)
        if have == asked:
            return []
        missing = [m for m in asked if m not in have]
        extra = [m for m in have if m not in asked]
        return [f"missing {m}" for m in missing] + [f"unexpected {m}" for m in extra] or ["the counts differ"]
    return check


# --- 5. commands -------------------------------------------------------------

def load_rules(s: Settings) -> List[Rule]:
    prepare_dir(s)
    phase("exporting the rules")
    tmp = s.backup_dir / f".{SCRIPT_NAME}.{os.getpid()}.list.json"
    try:
        return rules_of(export_model(s, tmp))
    finally:
        with contextlib.suppress(OSError):
            tmp.unlink()


def cmd_list(s: Settings, args: Sequence[str]) -> int:
    if len(args) > 1:
        err("00029", "list takes one <FILTER> at most")
    rules = load_rules(s)
    shown = [line for line in (rule_line(r) for r in rules) if not args or args[0] in line]
    for line in shown:
        OUT.result(line)
    todo = sum(1 for line in shown if "cleanup?[" in line)
    OUT.msg(f" >>> {len(shown)} of {len(rules)} rule(s)" + (f"; {todo} outdated -- '{SCRIPT_NAME} cleanup' shows them" if todo else ""))
    return 0


@dataclass
class RuleArgs:
    go: bool = False
    process: str = ""
    remote: str = ""
    port: str = "443"
    host: bool = False
    owner: Optional[str] = None


def parse_rule_args(verb: str, args: Sequence[str]) -> RuleArgs:
    a = RuleArgs()
    rest: List[str] = []
    it = iter(args)
    for x in it:
        key, eq, val = x.partition("=")
        if key in ("--port", "--owner"):
            v = val if eq else next(it, None)
            if not v:
                err("00030", f"{key} needs a value")
            if key == "--port":
                if v != "any" and not re.fullmatch(r"\d+(-\d+)?", v):
                    err("00031", f"--port '{v}': a number, a range like 6881-6889, or any")
                a.port = v
            else:
                a.owner = v
        elif x == "--host":
            a.host = True
        elif x.startswith("-"):
            err("00032", f"no such option for {verb}: '{x}' ({SCRIPT_NAME} --help)")
        else:
            rest.append(x)
    if rest[:1] == ["go"]:
        a.go = True
        rest = rest[1:]
    if len(rest) != 2:
        err("00033", f"{verb} [go] <PROCESS> <REMOTE> -- e.g. {SCRIPT_NAME} {verb} aria2c any")
    a.process, a.remote = rest
    return a


def new_rule(s: Settings, action: str, a: RuleArgs) -> Tuple[Rule, Program, str]:
    prog = find_program(s, a.process)
    owner_fields, owner_shown = find_owner(s, a.owner)
    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    r: Rule = {"action": action}
    if prog.process is not None:
        r["process"] = prog.process
    if a.remote == "any":
        r["remote"] = "any"
    else:
        r["remote-hosts" if a.host else "remote-domains"] = a.remote
    if a.port != "any":
        r["ports"], r["protocol"] = a.port, "tcp"
    r.update(owner_fields)
    r.update({"origin": "frontend", "creationDate": now, "modificationDate": now})
    return r, prog, owner_shown


def cmd_add(s: Settings, action: str, args: Sequence[str]) -> int:
    a = parse_rule_args(action, args)
    r, prog, _ = new_rule(s, action, a)
    if prog.process is not None:
        OUT.msg(f" >>> process: {prog.process}")
        if prog.note:
            OUT.msg(f"    > {prog.note}")
    rules = load_rules(s)
    same = [x for x in rules if rule_meaning(x) == rule_meaning(r)]
    if same:
        OUT.msg(f" >>> already there: {rule_line(same[0])}")
        return 0
    shown = rule_line(r).split("\t", 1)[1]
    if not a.go:
        OUT.msg(f" >>> would add: {shown}")
        OUT.msg(f"    > '{SCRIPT_NAME} {action} go {shlex.join(args)}' adds it")
        return 0
    want = rules + [r]
    backup = change_model(s, lambda now: now + [r], expect_rules(want))
    OUT.msg(f" >>> added: {shown}  [rules {len(rules)} -> {len(want)}]")
    OUT.msg(f"    > stored and read back -- proven only by a connection it lets through: "
            f"{SCRIPT_NAME} log {shlex.quote(a.remote if a.process == 'any' else a.process)}")
    OUT.det(f"    > the rules before: {backup}")
    return 0


def ids_from(args: Sequence[str]) -> List[str]:
    """IDs as arguments, else one per line on stdin -- the first word of a
    `list` line is enough."""
    if args:
        return list(args)
    if sys.stdin.isatty():
        return []
    phase("reading the IDs on stdin")
    return [line.split()[0] for line in sys.stdin.read().splitlines() if line.strip()]


def remove_rules(s: Settings, verb: str, go: bool, pick: Callable[[List[Rule]], List[Rule]]) -> int:
    rules = load_rules(s)
    chosen = pick(rules)
    for r in chosen:
        OUT.result(rule_line(r))
    if not chosen:
        OUT.msg(" >>> nothing to remove")
        return 0
    if not go:
        OUT.msg(f" >>> {len(chosen)} rule(s) would be removed -- '{SCRIPT_NAME} {verb} go' removes them")
        return 0
    gone = {rule_key(r) for r in chosen}
    keep = [r for r in rules if rule_key(r) not in gone]
    change_model(s, lambda now: [r for r in now if rule_key(r) not in gone], expect_rules(keep))
    OUT.msg(f" >>> removed {len(chosen)} rule(s)  [rules {len(rules)} -> {len(keep)}]")
    return 0


def cmd_remove(s: Settings, args: Sequence[str]) -> int:
    go = args[:1] == ["go"]
    ids = ids_from(args[1:] if go else args)
    if not ids:
        err("00034", f"remove [go] <ID>.. -- or the IDs on stdin: {SCRIPT_NAME} list x | cut -f 1 | {SCRIPT_NAME} remove")
    bad = [i for i in ids if not re.fullmatch(r"[0-9a-f]{6}", i)]
    if bad:
        err("00035", f"not an ID (6 hex digits, the first column of 'list'): {' '.join(bad[:5])}")

    def pick(rules: List[Rule]) -> List[Rule]:
        by_id = {rule_id(r): r for r in rules}
        unknown = [i for i in ids if i not in by_id]
        if unknown:
            err("00036", f"no rule with ID {' '.join(unknown[:5])} -- 'list' again: a changed rule has a new ID")
        return [by_id[i] for i in dict.fromkeys(ids)]

    return remove_rules(s, "remove", go, pick)


def cmd_cleanup(s: Settings, args: Sequence[str]) -> int:
    if args not in ([], ["go"]):
        err("00037", "cleanup [go] -- it takes nothing else")
    return remove_rules(s, "cleanup", args == ["go"], lambda rules: [r for r in rules if verdict(r).startswith("cleanup?")])


_SINCE: Final = re.compile(r"(\d+)([mhd])$")


def since_of(text: str) -> datetime.datetime:
    m = _SINCE.match(text)
    if m is None:
        err("00038", f"--since '{text}': a number and m, h or d (30m, 1h, 2d)")
    unit = {"m": 60, "h": 3600, "d": 86400}[m.group(2)]
    return datetime.datetime.now() - datetime.timedelta(seconds=int(m.group(1)) * unit)


PROTOCOLS: Final = {"6": "tcp", "17": "udp", "1": "icmp", "58": "icmp6"}


def human_bytes(text: str) -> str:
    n = float(text or 0)
    for unit in ("B", "KB", "MB"):
        if n < 1024:
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} GB"


def traffic_line(row: Dict[str, str], wide: bool) -> str:
    """One line per row of log-traffic. A row is a sample of a connection, so
    its bytes say whether anything moved; `connects` counts only the new
    connections in that sample, and is shown only when there were any."""
    when = datetime.datetime.strptime(row["date"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc).astimezone()
    exe = row.get("connectingExecutable", "")
    prog = exe if wide else (os.path.basename(exe) or "?")
    remote = row.get("remoteHostname") or row.get("ipAddress", "?")
    n = int(row.get("connectCount") or 0)
    denied = int(row.get("denyCount") or 0)
    return (f"{when:%Y-%m-%d %H:%M:%S}  {row.get('direction', '?'):<3}  {prog}  {remote}  "
            f"{PROTOCOLS.get(row.get('protocol', ''), row.get('protocol', '?'))}/{row.get('port', '?')}  "
            f"in {human_bytes(row.get('byteCountIn', '0'))} out {human_bytes(row.get('byteCountOut', '0'))}"
            + (f"  {n} connect{'s' if n != 1 else ''}" if n else "") + (f"  DENIED {denied}" if denied else ""))


def cmd_log(s: Settings, args: Sequence[str]) -> int:
    since, denied, what = "1h", False, None
    it = iter(args)
    for x in it:
        key, eq, val = x.partition("=")
        if key == "--since":
            v = val if eq else next(it, None)
            if not v:
                err("00039", "--since needs a time: 30m, 1h, 2d")
            since = v
        elif x == "--denied":
            denied = True
        elif x.startswith("-"):
            err("00040", f"no such option for log: '{x}' ({SCRIPT_NAME} --help)")
        elif what is None:
            what = x
        else:
            err("00041", "log [<PROCESS>|<FILTER>] [--since 1h] [--denied] -- one PROCESS or FILTER")
    start = since_of(since)
    pattern: Optional[str] = None
    if what is not None and ("/" in what or shutil.which(what, path=":".join(
            os.environ.get("PATH", "").split(":") + list(s.program_path)))):
        prog = find_program(s, what)
        pattern = prog.path
        OUT.det(f" >>> {what} = {pattern}")
    cmd = [s.littlesnitch, "log-traffic", "-b", f"{start:%Y-%m-%d %H:%M:%S}"]
    OUT.det(f" >>> {shlex.join(cmd)}")
    phase("reading the traffic log")
    try:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, stdin=subprocess.DEVNULL)
    except FileNotFoundError:
        err("00042", f"Little Snitch's command line tool is not at {s.littlesnitch} (LITTLESNITCH in the config)")
    assert p.stdout is not None and p.stderr is not None, "both pipes were asked for"
    shown = seen = 0
    first = p.stdout.readline()
    if first.startswith("date,"):
        for row in csv.DictReader(p.stdout, fieldnames=next(csv.reader([first]))):
            seen += 1
            exe = row.get("connectingExecutable") or ""
            parent = row.get("parentAppExecutable") or ""
            if pattern is not None and not (fnmatch.fnmatchcase(exe, pattern) or fnmatch.fnmatchcase(parent, pattern)):
                continue
            if denied and not int(row.get("denyCount") or 0):
                continue
            line = traffic_line(row, OUT.vrb)
            if pattern is None and what is not None and what not in line:
                continue
            shown += 1
            OUT.result(line)
    rest = first + p.stdout.read() if not first.startswith("date,") else ""
    errs = p.stderr.read()
    rc = p.wait()
    said = (rest + errs).strip()
    if "not authorized" in said:
        err("00043", "Little Snitch refuses its command line tool -- switch on "
                     "Little Snitch > Settings > Security > \"Allow access via Terminal\"")
    if rc != 0:
        err("00044", f"littlesnitch log-traffic failed [rc {rc}]: {said[:300]}")
    which = f"{what} = {pattern}" if pattern else (f"lines holding '{what}'" if what else "everything")
    OUT.msg(f" >>> {shown} of {seen} line(s) since {start:%Y-%m-%d %H:%M}: {which}" + (", denied only" if denied else ""))
    return 0


def cmd_diag(s: Settings, args: Sequence[str]) -> int:
    if args[:1] == ["events"]:
