class T:
    """One test: its folder, a stub littlesnitch, what it found wrong."""

    def __init__(self, folder: Path) -> None:
        self.dir = folder
        self.bad: List[str] = []
        self.stub = folder / "littlesnitch"
        self.stub.write_text(f"#!{sys.executable}\n" + STUB.split("\n", 1)[1], encoding="utf-8")
        self.stub.chmod(0o755)
        self.cellar = folder / "Cellar"
        me = pwd.getpwuid(os.getuid())
        self.user, self.uid = me.pw_name, me.pw_uid
        prog = self.cellar / "aria2" / "1.37.0" / "bin" / "aria2c"
        prog.parent.mkdir(parents=True)
        prog.write_text("#!/bin/sh\n")
        prog.chmod(0o755)
        (folder / "bin").mkdir()
        (folder / "bin" / "aria2c").symlink_to(prog)
        (folder / "traffic.csv").write_text(TRAFFIC.format(cellar=self.cellar), encoding="utf-8")
        self.model([
            {"action": "allow", "process": "path." + str(prog)[1:], "remote-domains": "keep.org", "ports": "443",
             "protocol": "tcp", "uid": self.uid},
            {"action": "allow", "process": "path.usr/local/Cellar/python@3.10/*/bin/python3", "remote-domains": "pypi.org"},
            {"action": "allow", "process": "identifier.APPLE/com.apple.curl", "remote": "any", "uid": 77777},
            {"action": "suggestion", "process": "identifier.APPLE/com.apple.ssh", "remote": "any", "owner": "system"},
            {"action": "deny", "remote": "any", "direction": "incoming"},
        ])

    def check(self, ok: bool, what: str) -> None:
        if not ok:
            self.bad.append(what)

    def model(self, rules: List[Rule]) -> None:
        (self.dir / "model.json").write_text(json.dumps({"rules": rules, "other": 1}), encoding="utf-8")

    def rules(self) -> List[Rule]:
        return rules_of(json.loads((self.dir / "model.json").read_text(encoding="utf-8")))

    def mode(self, name: str) -> None:
        (self.dir / name).write_text("1", encoding="utf-8")

    def config(self, extra: str = "") -> Path:
        p = self.dir / "conf"
        p.write_text(f'LITTLESNITCH="{self.stub}"\nBACKUP_DIR="{self.dir}/state"\nOWNER_DEFAULT="{self.user}"\n'
                     f'PROGRAM_PATH="{self.dir}/bin"\n' + extra, encoding="utf-8")
        return p

    def passed_roundtrip(self) -> None:
        (self.dir / "state").mkdir(exist_ok=True)
        (self.dir / "state" / ROUNDTRIP_OK).write_text("passed in the test\n", encoding="utf-8")

    def run(self, argv: Sequence[str], stdin: str = "") -> Tuple[int, str, str]:
        """The tool in-process, as root, from a shell: rc, stdout, stderr."""
        out, errs = io.StringIO(), io.StringIO()
        old_in, old_path = sys.stdin, os.environ.get("PATH", "")
        sys.stdin = io.StringIO(stdin)
        os.environ["PATH"] = f"{self.dir}/bin:/usr/bin:/bin"     # the test's aria2c, not this machine's
        try:
            with contextlib.redirect_stdout(out), contextlib.redirect_stderr(errs):
                rc = main(["--config", str(self.config()), *argv])
        finally:
            sys.stdin, os.environ["PATH"] = old_in, old_path
            OUT.__init__()
        return rc, out.getvalue(), errs.getvalue()


def t_list_verdicts(t: T) -> None:
    rc, out, errs = t.run(["list"])
    lines = out.splitlines()
    t.check(rc == 0 and len(lines) == 5, f"one line per rule: {out}")
    t.check(all(re.match(r"[0-9a-f]{6}\t", line) for line in lines), "an ID of 6 hex, then a TAB")
    t.check("cleanup?[program-gone]" in lines[1], f"a rule whose program is gone: {lines[1]}")
    t.check("cleanup?[user-gone]" in lines[2], f"a rule whose owner is no user: {lines[2]}")
    t.check("cleanup?[expired]" in lines[3], f"an expired suggestion: {lines[3]}")
    t.check("allow?[version-path]" in lines[0] and "cleanup?" not in lines[0], f"a version path: {lines[0]}")
    t.check(lines[4].endswith(f"any  in deny  any  any  anyone"), f"any process, anyone, incoming: {lines[4]}")
    t.check(" 3 outdated" in errs, f"the summary counts the outdated ones: {errs}")
    _, out2, _ = t.run(["list"])
    t.check([x.split("\t")[0] for x in out2.splitlines()] == [x.split("\t")[0] for x in lines],
            "the IDs stay the same while Little Snitch's counters move")
    t.check(show_process({"process": "script./usr/local/bin/x.sh"}) == "script /usr/local/bin/x.sh"
            and show_process({"process": "path.opt/x"}) == "/opt/x", "one slash before a script's or a path's path")
    _, out3, _ = t.run(["list", "pypi"])
    t.check(out3.splitlines() == [lines[1]], f"a FILTER: {out3}")


def t_allow_shows_then_go(t: T) -> None:
    t.passed_roundtrip()
    rc, _, errs = t.run(["allow", "aria2c", "example.org"])
    t.check(rc == 0 and "would add:" in errs and len(t.rules()) == 5, f"without go nothing changes: {errs}")
    t.check(f"path.{str(t.cellar)[1:]}/aria2/*/bin/aria2c" in errs, f"the Homebrew version made '*': {errs}")
    t.check("its version folder made '*', as Little Snitch's alert writes it" in errs, "and it says so")
    rc, _, errs = t.run(["allow", "go", "aria2c", "example.org"])
    new = t.rules()[-1]
    t.check(rc == 0 and "added:" in errs and len(t.rules()) == 6, f"go adds it: {errs}")
    t.check("proven only by a connection it lets through: my-little-snitch log aria2c" in errs,
            f"'added' does not claim the rule works: {errs}")
    t.check(new.get("remote-domains") == "example.org" and new.get("ports") == "443"
            and new.get("protocol") == "tcp" and new.get("uid") == t.uid and "direction" not in new,
            f"the rule as the alert writes it: {new}")
    t.check(len(list((t.dir / "state").glob("*.json"))) == 1, "one backup per change")
    rc, _, errs = t.run(["allow", "go", "aria2c", "example.org"])
    t.check(rc == 0 and "already there" in errs and len(t.rules()) == 6, f"never doubled: {errs}")
    rc, _, errs = t.run(["deny", "go", "any", "evil.example", "--owner", "anyone", "--port", "any"])
    new = t.rules()[-1]
    t.check("connection it lets through: my-little-snitch log evil.example" in errs,
            f"for any process the proof is the remote's log, not 'log any': {errs}")
    t.check(rc == 0 and "process" not in new and "uid" not in new and "ports" not in new and new["action"] == "deny",
            f"any process, anyone, any port: {new} {errs}")


def t_python_is_its_app(t: T) -> None:
    fw = t.cellar / "python@3.15" / "3.15.0" / "Frameworks" / "Python.framework" / "Versions" / "3.15"
    (fw / "bin").mkdir(parents=True)
    app = fw / "Resources" / "Python.app" / "Contents" / "MacOS" / "Python"
    app.parent.mkdir(parents=True)
    app.write_text("x")
    (fw / "bin" / "python3.15").write_text("x")
    (fw / "bin" / "python3.15").chmod(0o755)
    (t.dir / "bin" / "python3").symlink_to(fw / "bin" / "python3.15")
    rc, _, errs = t.run(["allow", "python3", "example.org"])
    want = f"path.{str(t.cellar)[1:]}/python@3.15/*/Frameworks/Python.framework/Versions/3.15/Resources/Python.app/Contents/MacOS/Python"
    t.check(rc == 0 and want in errs, f"Little Snitch's own form: only the version folder '*', as its Python.app: {errs}")
    for bad in (f"{t.cellar}/python@*/*/Frameworks/Python.framework/Versions/3.15/Resources/Python.app/Contents/MacOS/Python",
                f"{t.cellar}/python@3.15/*/Frameworks/Python.framework/Versions/*/Resources/Python.app/Contents/MacOS/Python"):
        rc, _, errs = t.run(["allow", bad, "example.org"])
        t.check(rc == 1 and "matches a '*' only as Homebrew's version folder" in errs, f"refused: {bad}: {errs}")
    t.check(verdict({"process": f"path.{str(t.cellar)[1:]}/python@*/*/bin/python3", "remote": "any"})
            == "cleanup?[never-matches]", "a stored rule with such a '*' is marked as never matching")


def t_roundtrip_gate(t: T) -> None:
    rc, _, errs = t.run(["allow", "go", "aria2c", "x.org"])
    t.check(rc == 1 and "diag roundtrip go" in errs and len(t.rules()) == 5, f"no change before the roundtrip: {errs}")
    rc, _, errs = t.run(["diag", "roundtrip"])
    t.check(rc == 0 and "would export" in errs and not (t.dir / "restored").exists(), f"roundtrip without go: {errs}")
    rc, _, errs = t.run(["diag", "roundtrip", "go"])
    t.check(rc == 0 and "roundtrip passed: 5 rules" in errs and (t.dir / "state" / ROUNDTRIP_OK).is_file(), errs)
    rc, _, errs = t.run(["allow", "go", "aria2c", "x.org"])
    t.check(rc == 0 and len(t.rules()) == 6, f"after it, changes go through: {errs}")


