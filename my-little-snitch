#!/usr/bin/env python3
"""my-little-snitch -- Little Snitch's rules and traffic from the command line.

A wrapper around Little Snitch's own `littlesnitch`, which can export and
restore the whole rule model and print the traffic log, but has no command to
add or remove ONE rule. `my-little-snitch --help` says how to drive it.

One file, in this order:
  1. output, errors, config
  2. littlesnitch: calling it, the model, a rule as one line
  3. programs: a name or path -> the rule's process (Homebrew versions -> '*')
  4. changing the model: lock, backup, restore, verify
  5. commands, main, --run-tests
"""

from __future__ import annotations

